# Your Claude API key (https://console.anthropic.com). Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-...
# Required if the key is an organization-level key rather than a workspace key
# (the API answers "must include the anthropic-workspace-id header"). Console → Settings → Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=medium
# PORT=3000
